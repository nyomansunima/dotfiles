{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
    },
    "mcp-server": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp-server"],
      "environment": {},
      "enabled": true,
    },
    "github": {
      "type": "local",
      "command": ["npx", "envmcp", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
    },
    "ui-skills": {
      "type": "remote",
      "url": "https://www.ui-skills.com/mcp",
      "enabled": true,
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": true,
    },
  },
}
