# Github Git Integration SSH
Host github.com
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_github

# Custom Gitlab by Balimmo
Host g1tlab.ops.balimmo.dev
  HostName g1tlab.ops.balimmo.dev
  User git
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_github
  PreferredAuthentications publickey

# Balimmo server
Host balimmo-local-server
  HostName 192.168.1.81
  User root
  IdentityFile ~/.ssh/id_balimmo
  AddKeysToAgent yes
  UseKeychain yes
